# Keep the existing historical preview until a development database is ready.
CONTENT_SOURCE=sample

# Optional server-side Auth. Run auth:start, then copy the local publishable key
# from auth:status. Leave all three unset to preview without authentication.
# Use localhost consistently in your browser; APP_ORIGIN is the exact origin.
# APP_ORIGIN=http://localhost:3000
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_PUBLISHABLE_KEY

# Local development can use native PostgreSQL instead of hosted Supabase.
# Use its local URL for DATABASE_URL and omit DATABASE_MIGRATION_URL.
# Tests require a separate, disposable local database named mina_content_test.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55438/mina_content_test

# Runtime: Supabase transaction pooler (port 6543). Keep secrets server-side.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=verify-full

# Migrations/seeding: direct connection or session pooler (port 5432).
# If omitted, database scripts use DATABASE_URL (suitable for local Postgres).
DATABASE_MIGRATION_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full
